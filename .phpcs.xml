<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="WordPress Coding Standards">
	<description>WordPress coding standards for amiriset-meta-manager</description>

	<!-- Exclude files and paths. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tmp/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>

	<!-- Show progress. -->
	<arg value="p"/>
	<arg name="colors"/>

	<!-- Multiple arguments and dot notation. -->
	<arg name="extensions" value="php"/>

	<!-- WordPress Coding Standards. -->
	<config name="minimum_supported_wp_version" value="6.0"/>

	<!-- Include the WordPress standards. -->
	<rule ref="WordPress">
		<exclude name="WordPress.WhiteSpace.ControlStructureSpacing.NoSpaceBetweenStructureColon"/>
	</rule>

	<!-- Include WordPress security best practices. -->
	<rule ref="WordPress.Security"/>

	<!-- Include WordPress documentation standards. -->
	<rule ref="WordPress.Files.FileName"/>

	<!-- Text domain for translation. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="amiriset-meta-manager"/>
			</property>
		</properties>
	</rule>
</ruleset>
